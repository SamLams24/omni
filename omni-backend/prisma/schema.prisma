// OMNI backend Prisma schema.
//
// Derived from the real, currently-deployed schema in
// apps/web/db/migrations/0001_baseline.sql .. 0006_vendor_verification.sql
// (see docs/architecture/current-state-audit.md for the full audit). This
// is a NEW schema for a NEW development database -- no production data is
// migrated by this file, and apps/web's own migrations are untouched.
//
// Scope note (Lot 1 -- foundation only): this schema covers auth/RBAC,
// businesses, KYC, subscriptions, the FedaPay wallet flow, reviews,
// favorites, notifications, and audit logging -- the entities explicitly
// listed as the Lot 1 target in the mission brief. Legacy modules not yet
// scheduled (cart, delivery, escrow, chat, proximity) are intentionally
// left out here; they are ported in Lot 7 per docs/architecture/migration-plan.md
// once their own modules are actually built, rather than adding empty
// placeholder tables now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & RBAC -- entirely new. The legacy app (apps/web) has no roles or
// permissions at all, only ad-hoc string checks; this replaces that gap.
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  bio          String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles         UserRole[]
  refreshTokens RefreshToken[]
  businesses    BusinessOwner[]
  kycRequests   KycRequest[]     @relation("KycRequestUser")
  kycReviews    KycRequest[]     @relation("KycRequestReviewer")
  subscriptions Subscription[]
  wallet        Wallet?
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Businesses -- maps to legacy `vendors` (+ its 0006 KYC/OSM columns).
// `facilities` (multiple locations per vendor) is intentionally not ported
// in Lot 1; Business models the single-location case used by most of the
// legacy data, and a Facility model can be reintroduced in Lot 3 if the
// multi-location workflow is actually migrated.
// ---------------------------------------------------------------------------

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  REVOKED

  @@map("kyc_status")
}

enum BusinessSource {
  OMNI
  OSM

  @@map("business_source")
}

enum OsmType {
  NODE
  WAY
  RELATION

  @@map("osm_type")
}

model Business {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  categoryId      String?        @map("category_id") @db.Uuid
  description     String?
  phone           String
  email           String?
  address         String?
  neighborhood    String?
  // PostGIS point, mirrors legacy `vendors.location geography(Point,4326)`.
  // Prisma has no native geography type -- proximity queries go through
  // $queryRaw (ST_DWithin/ST_Distance), same approach as the legacy
  // discovery-service.js. See docs/architecture/target-architecture.md.
  location        Unsupported("geography(Point,4326)")?
  isOnline        Boolean        @default(true) @map("is_online")
  isAvailable     Boolean        @default(true) @map("is_available")
  rating          Decimal?       @db.Decimal(3, 2)
  kycStatus       KycStatus      @default(NONE) @map("kyc_status")
  kycReviewedAt   DateTime?      @map("kyc_reviewed_at")
  source          BusinessSource @default(OMNI)
  osmType         OsmType?       @map("osm_type")
  osmId           BigInt?        @map("osm_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  category      Category?      @relation(fields: [categoryId], references: [id])
  owners        BusinessOwner[]
  products      Product[]
  services      Service[]
  kycRequests   KycRequest[]
  subscriptions Subscription[]
  reviews       Review[]
  favorites     Favorite[]

  @@unique([osmType, osmId], name: "business_osm_identity")
  @@index([kycStatus])
  @@map("businesses")
}

model BusinessOwner {
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String   @default("owner") // "owner" | "manager" -- free text, not enum-worthy yet
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([businessId, userId])
  @@map("business_owners")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  businesses Business[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("XOF")
  unit        String   @default("pièce")
  isAvailable Boolean  @default(true) @map("is_available")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@map("products")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String
  description String?
  price       Decimal? @db.Decimal(10, 2)
  currency    String   @default("XOF")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@map("services")
}

// ---------------------------------------------------------------------------
// KYC -- entirely new. The legacy KycForm.jsx is a 100% client-side
// simulation (setTimeout, no persistence); this is the real workflow.
// ---------------------------------------------------------------------------

model KycRequest {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  status       KycStatus @default(PENDING)
  documents    Json      @default("[]") // array of storage refs; storage itself is abstracted by a service, not modeled here
  rejectReason String?   @map("reject_reason")
  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation("KycRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("KycRequestReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@map("kyc_requests")
}

// ---------------------------------------------------------------------------
// Subscriptions -- maps to legacy `subscriptions` table, which existed
// since the baseline migration but was entirely unused by any query before
// this mission. `status` is new (0006); legacy only had start/end dates,
// which cannot express "paid" vs "cancelled" vs "payment failed".
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  FREE
  PREMIUM

  @@map("subscription_tier")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED

  @@map("subscription_status")
}

model SubscriptionPlan {
  id            String           @id @default(uuid()) @db.Uuid
  tier          SubscriptionTier
  name          String
  priceAmount   Decimal          @map("price_amount") @db.Decimal(10, 2)
  priceCurrency String           @default("XOF") @map("price_currency")
  createdAt     DateTime         @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  businessId String?            @map("business_id") @db.Uuid
  planId     String?            @map("plan_id") @db.Uuid
  tier       SubscriptionTier   @default(FREE)
  status     SubscriptionStatus @default(PENDING)
  startDate  DateTime           @default(now()) @map("start_date")
  endDate    DateTime?          @map("end_date")
  createdAt  DateTime           @default(now()) @map("created_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business?         @relation(fields: [businessId], references: [id])
  plan     SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([userId, status, endDate])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Wallet & FedaPay -- faithful port of the legacy wallet deposit flow
// (apps/web/src/lib/fedapay.js, wallet-deposits.js, db/migrations/0004,
// 0005), which is real, tested (29 tests), working code. Not a redesign.
// ---------------------------------------------------------------------------

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  FEE

  @@map("wallet_transaction_type")
}

enum DepositStatus {
  PENDING
  SETTLED
  FAILED
  CANCELLED

  @@map("deposit_status")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED

  @@map("webhook_event_status")
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  deposits     WalletDepositIntent[]

  @@map("wallets")
}

model WalletTransaction {
  id        String                @id @default(uuid()) @db.Uuid
  walletId  String                @map("wallet_id") @db.Uuid
  type      WalletTransactionType
  amount    Decimal               @db.Decimal(12, 2)
  reference String?               @unique
  createdAt DateTime              @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model WalletDepositIntent {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  walletId             String?       @map("wallet_id") @db.Uuid
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("XOF")
  provider             String        @default("fedapay")
  providerTransactionId String?      @unique @map("provider_transaction_id")
  status               DepositStatus @default(PENDING)
  expiresAt            DateTime      @map("expires_at")
  settledAt            DateTime?     @map("settled_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  wallet Wallet? @relation(fields: [walletId], references: [id])

  @@index([userId, status, createdAt])
  @@map("wallet_deposit_intents")
}

model FedapayWebhookEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  providerEventId       String              @unique @map("provider_event_id")
  eventName             String              @map("event_name")
  providerTransactionId String?             @map("provider_transaction_id")
  status                WebhookEventStatus  @default(RECEIVED)
  attempts              Int                 @default(0)
  lastErrorCode         String?             @map("last_error_code")
  firstReceivedAt       DateTime            @default(now()) @map("first_received_at")
  lastReceivedAt        DateTime            @default(now()) @map("last_received_at")
  processedAt           DateTime?           @map("processed_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@index([status, lastReceivedAt])
  @@map("fedapay_webhook_events")
}

// ---------------------------------------------------------------------------
// Reviews, favorites, notifications -- simple 1:1 ports of legacy tables.
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  rating     Int      @db.SmallInt
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@map("reviews")
}

model Favorite {
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@map("favorites")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @default("info")
  title     String
  message   String?
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit -- entirely new. Required by the mission brief for sensitive admin
// actions (KYC approval/rejection, role changes, refunds, ...).
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
