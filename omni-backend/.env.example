NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=v1

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/omni_dev?schema=public
# Neon production only: the unpooled connection string, used by `prisma
# migrate deploy`. Leave unset locally -- Prisma falls back to
# DATABASE_URL when DIRECT_URL is absent. See docs/deployment-neon.md.
DIRECT_URL=

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

JWT_ACCESS_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
JWT_REFRESH_SECRET=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=

OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSM_CACHE_TTL_SECONDS=300

LOG_LEVEL=debug
SWAGGER_ENABLED=true

# Auth0/OIDC -- optional. Social login is scaffolded but non-functional
# without real tenant credentials; leave all four unset to keep it that
# way. See docs/auth0-setup.md.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=
AUTH0_AUDIENCE=
