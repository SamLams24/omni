# Database
DATABASE_URL="postgresql://localhost/omni"

# Auth
AUTH_SECRET="your-secret-key-here-change-in-production"
AUTH_URL="http://localhost:4001"

# Neon Auth URL - Format: https://<project-id>.neonauth.<region>.neon.tech/<database>/auth
NEON_AUTH_URL="https://<project-id>.neonauth.<region>.neon.tech/<database>/auth"
NEXT_PUBLIC_NEON_AUTH_URL="https://<project-id>.neonauth.<region>.neon.tech/<database>/auth"

# Create XYZ (if needed)
NEXT_PUBLIC_PROJECT_GROUP_ID=""

# FedaPay (Mobile Money)
# Application ID (dashboard reference only, not used in API calls)
VITE_FEDAPAY_APP_ID=""
# Server-side secret key (NEVER expose to client)
FEDAPAY_SECRET_KEY=""
# Explicitly select "sandbox" or "live". Defaults to sandbox when omitted.
FEDAPAY_ENVIRONMENT="sandbox"
# Secret of the exact webhook endpoint configured in the FedaPay dashboard.
# Test and live endpoints have different secrets.
FEDAPAY_WEBHOOK_SECRET=""
# Server-enforced XOF deposit limits.
FEDAPAY_MIN_DEPOSIT_AMOUNT="100"
FEDAPAY_MAX_DEPOSIT_AMOUNT="1000000"
# Legacy Checkout.js public key. The wallet deposit flow now uses the
# server-generated hosted URL and does not require this value.
VITE_FEDAPAY_PUBLIC_KEY=""

# Development-only mock features.
# These flags are always ignored when NODE_ENV=production.
ALLOW_DEVELOPMENT_SEED="false"
ENABLE_MOCK_DELIVERY_TRACKING="false"
